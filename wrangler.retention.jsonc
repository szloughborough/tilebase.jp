{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tilebase-inquiry-retention",
  "main": "server/inquiry-retention-worker.mjs",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "tilebase-inquiries",
    "database_id": "fc76e290-1756-4fff-a7cc-43f8aef01b98"
  }]
}
