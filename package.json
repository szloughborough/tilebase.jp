{
  "name": "tilebase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "audit": "node scripts/audit.mjs",
    "deploy": "wrangler pages deploy dist --project-name tilebase",
    "local:full": "wrangler pages dev dist --port 4322",
    "check:launch": "node scripts/launch-check.mjs"
  },
  "dependencies": {
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0",
    "vite": "^6.4.3"
  }
}
