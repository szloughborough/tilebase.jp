{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tilebase",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-05",
  "vars": { "SITE_STAGE": "preview", "SITE_URL": "https://tilebase.jp" },
  "d1_databases": [{ "binding": "DB", "database_name": "tilebase-inquiries", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }]
}
