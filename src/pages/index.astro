---
import { articleVisuals } from '../data/editorial-images';
import { articles } from '../data/articles';
import Base from '../layouts/Base.astro';
import Products from '../components/Products.astro';
---
<Base title="タイルシール・粘着式フロアタイルの法人向け製品案内" description="Tilebaseは日本市場向けのウォール・フロアタイルの製品と調達情報を提供。デザイン選定から仕様確認、サンプル、OEM・PBの相談へ。">
  <section class="vi-hero"><div class="container vi-hero-inner"><div class="vi-hero-copy"><p class="eyebrow">WALL & FLOOR / FOR YOUR BUSINESS</p><h1>空間をつくる素材で、<br />ビジネスの可能性を広げる。</h1><p class="vi-hero-description">壁と床に、新しい選択を。<br />ウォール・フロアタイルの卸売、OEM・PB、法人調達。</p><div class="button-row"><a href="/products/" class="button">製品一覧 <span aria-hidden="true">→</span></a><a href="/quote/" class="button button-outline">見積について相談 <span aria-hidden="true">→</span></a></div><p class="vi-hero-foot">DESIGN · MATERIAL · SOURCING</p></div><div class="vi-hero-media"><img class="vi-space" src="/images/tb-f-046-gallery-1.webp" alt="ストーン調フロアデザインの室内展示イメージ" width="1200" height="1200" fetchpriority="high" /><div class="vi-materials"><img src="/images/tb-f-039-main.webp" alt="木目柄のデザイン候補" width="720" height="720" /><img src="/images/tb-f-046-main.webp" alt="ストーン調のデザイン候補" width="720" height="720" /><span>FOR<br />BETTER<br />SPACES</span></div><p class="vi-caption">使用イメージ。仕様・適合条件は品番ごとに確認。</p></div></div></section>
  <section class="container vi-paths" aria-label="法人調達のメニュー">{[
    ['/products/','製品一覧','ウォール・フロアのデザイン','/images/tb-f-046-main.webp'],
    ['/oem/','OEM・プライベートブランド','デザインから商品企画へ','/images/tb-w-037-gallery-1.webp'],
    ['/wholesale/','卸売・法人仕入れ','数量・包装・供給条件を確認','/images/tb-f-051-gallery-1.webp'],
    ['/wholesale/samples/','サンプル相談','色・質感を実物で確かめる','/images/tb-f-039-main.webp'],
    ['/specifications/','仕様・資料','寸法・構造・包装を確認','/images/tb-w-003-main.webp'],
  ].map(([href,title,copy,image])=><a class="vi-path" href={href}><img src={image} alt="" width="720" height="720" loading="lazy" /><div><h2>{title}</h2><p>{copy}</p><span aria-hidden="true">→</span></div></a>)}</section>
  <div class="intro-strip"><div class="container"><span>素材を選ぶ。</span><span>仕様を確かめる。</span><span>ビジネスにつなげる。</span><a href="/company/">ABOUT TILEBASE</a></div></div>
  <section class="container home-section"><div class="section-heading"><div><p class="eyebrow">OUR MATERIALS</p><h2>壁と床、二つのコレクション。</h2></div><a class="text-link" href="/products/">製品案内を見る</a></div><div class="family-grid"><a class="family-card" href="/products/wall-tiles/"><div class="family-image"><img src="/images/tb-w-037-gallery-1.webp" alt="淡い色のウォールタイル展示イメージ" width="720" height="720" loading="lazy" /></div><div class="family-copy"><div><span class="eyebrow">WALL COLLECTION</span><h3>ウォールタイル</h3><p>色と質感で、壁面に表情を。</p></div><span class="family-icon" aria-hidden="true">＋</span></div></a><a class="family-card" href="/products/floor-tiles/"><div class="family-image"><img src="/images/tb-f-039-gallery-1.webp" alt="木目柄フロアタイル展示イメージ" width="720" height="720" loading="lazy" /></div><div class="family-copy"><div><span class="eyebrow">FLOOR COLLECTION</span><h3>フロアタイル</h3><p>空間の印象を、足元から。</p></div><span class="family-icon" aria-hidden="true">＋</span></div></a></div></section>
  <section class="buyer-section"><div class="container buyer-layout"><div><p class="eyebrow">FOR YOUR BUSINESS</p><h2>販売する場所から、<br />必要な条件を考える。</h2><p>商品を選ぶ視点は、販売チャネルによって変わります。<br />用途とビジネスに合う確認項目を整理しましょう。</p></div><div class="buyer-links"><a href="/solutions/ecommerce-sellers/"><span>EC・Marketplace</span><p>商品画像・説明・包装・補充を検討</p><i aria-hidden="true">＋</i></a><a href="/solutions/distributors/"><span>商社・卸売</span><p>仕様・梱包・輸送・取引条件を比較</p><i aria-hidden="true">＋</i></a><a href="/solutions/private-label-brands/"><span>PB・ブランド</span><p>企画の意図を、継続できる商品仕様へ</p><i aria-hidden="true">＋</i></a></div></div></section>
  <section class="container home-section"><div class="section-heading"><div><p class="eyebrow">DESIGN SELECTION</p><h2>商品企画のヒントになるデザイン。</h2></div><a class="text-link" href="/designs/">すべてのデザインを見る</a></div><Products limit={4} featured /></section>
  <section class="container sample-feature"><div class="sample-composition"><img src="/images/tb-w-001-main.webp" alt="チェック柄ウォールタイルの実物デザイン" width="720" height="720" loading="lazy" /><img src="/images/tb-f-003-main.webp" alt="植物柄フロアタイルの実物デザイン" width="720" height="720" loading="lazy" /><span>MATERIAL / COLOR / DETAIL</span></div><div class="sample-copy"><p class="eyebrow">SEE IT. FEEL IT. CHECK IT.</p><h2>画面の向こうを、<br />実物で確かめる。</h2><p>色、質感、厚み、下地との相性。<br />写真では判断できないことを、採用前に確認。</p><ul class="plain-list"><li>実際の照明で色と光沢を確認</li><li>複数枚を並べて柄のつながりを比較</li><li>使用する下地で試験施工</li></ul><a class="button" href="/wholesale/samples/">サンプルについて相談</a><small>費用・供給可否・発送時期は個別に確認します。</small></div></section>
  <section class="process-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">FROM IDEA TO SOURCING</p><h2>企画から、条件の確認へ。</h2></div><a class="text-link" href="/oem/">OEM・PBの進め方</a></div><ol class="process-grid"><li><span>01</span><h3>用途を共有</h3><p>販売チャネルと商品イメージを整理。</p></li><li><span>02</span><h3>仕様を確認</h3><p>構造、品番、包装と対応範囲を確認。</p></li><li><span>03</span><h3>実物を評価</h3><p>見た目と施工条件をサンプルで確認。</p></li><li><span>04</span><h3>見積を検討</h3><p>数量、納期、取引条件を個別に合意。</p></li></ol></div></section>
  <section class="container home-section"><div class="section-heading"><div><p class="eyebrow">INFORMATION YOU CAN CHECK</p><h2>判断に必要な情報を、明確に。</h2></div></div><div class="trust-grid"><a href="/specifications/"><span class="eyebrow">SPECIFICATIONS</span><h3>製品の構造と使用条件</h3><p>材質、粘着、下地、用途。品番ごとの仕様を確認するために。</p><span class="text-link">仕様の確認項目</span></a><a href="/quality-control/"><span class="eyebrow">QUALITY</span><h3>品質と試験の適用範囲</h3><p>性能の言葉だけでなく、対象品番と試験条件を一緒に確認。</p><span class="text-link">品質資料の見方</span></a><a href="/resources/"><span class="eyebrow">BUYER GUIDE</span><h3>調達のためのチェックリスト</h3><p>サンプル評価、施工、見積。次に確認することを整理。</p><span class="text-link">導入ガイド</span></a></div></section>
  <section class="container home-section"><div class="section-heading"><div><p class="eyebrow">MATERIAL JOURNAL</p><h2>ブログ・調達ガイド</h2></div><a class="text-link" href="/blog/">すべての記事を見る</a></div><div class="article-grid">{articles.filter((_,i)=>[0,2,5].includes(i)).map(article=><a class="article-card" href={`/blog/${article.slug}/`}><img class="article-cover" src={articleVisuals[articles.indexOf(article)].cover.src} alt={articleVisuals[articles.indexOf(article)].cover.alt} width="1200" height="800" loading="lazy" /><div class="article-label"><span>{article.category}</span></div><h3>{article.title}</h3><p>{article.summary}</p><span class="text-link">記事を読む</span></a>)}</div></section>
</Base>
 
