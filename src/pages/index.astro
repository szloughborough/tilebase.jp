---
import { articleVisuals } from '../data/editorial-images';
import { articles } from '../data/articles';
import Base from '../layouts/Base.astro';
import MaterialStudio from '../components/MaterialStudio.astro';
const categories = [
  {href:'/products/wall-tiles/', title:'壁用タイルシール', image:'/images/tb-w-003-main.webp', alt:'装飾柄の壁用タイルシール TB-W-003', spec:'PET＋PUの参考仕様あり', detail:'柄・寸法・対応下地を品番ごとに確認できます。'},
  {href:'/products/floor-tiles/', title:'粘着式フロアタイル', image:'/images/tb-f-046-main.webp', alt:'石目調フロアタイル TB-F-046', spec:'基本寸法：20 × 20 cm／30 × 30 cm', detail:'木目や石目などの柄と、セット・箱の入数を確認できます。'},
];
const purchase = [
  ['/wholesale/','卸売・仕入れ','既存柄の発注単位、梱包、納期を確認する。'],
  ['/oem/','OEM・PB','オリジナル柄や日本語包装の対応範囲を確認する。'],
  ['/specifications/','製品仕様','材質、寸法、セット枚数、箱規格を確認する。'],
];
---
<Base title="タイルシール・粘着式フロアタイルの法人向け製品案内" description="日本の法人向けに、壁用タイルシール・粘着式フロアタイルの品番、仕様、梱包情報を掲載。卸売、OEM・PB、サンプルの相談窓口。">
  <MaterialStudio />
  <section class="container catalog-overview" aria-labelledby="product-groups">
    <div class="catalog-heading"><h2 id="product-groups">製品カテゴリ</h2><a class="text-link" href="/products/">製品一覧</a></div>
    <div class="category-index">
      {categories.map(({href,title,image,alt,spec,detail})=><a href={href} class="category-entry">
        <div class="category-swatch"><img src={image} alt={alt} width="720" height="720" loading="lazy" /></div>
        <div><h3>{title}</h3><p class="category-spec">{spec}</p><p>{detail}</p></div>
        <span class="index-arrow" aria-hidden="true">→</span>
      </a>)}
    </div>
  </section>
  <section class="procurement-index" aria-labelledby="buying-info"><div class="container procurement-inner">
    <div class="procurement-intro"><h2 id="buying-info">法人のお客様へ</h2><p>品番が未定の場合は、用途と希望数量からご相談いただけます。</p><a class="text-link" href="/quote/">法人見積の相談</a><nav class="procurement-audiences" aria-label="業態別のご案内"><a href="/solutions/ecommerce-sellers/">EC事業者</a><a href="/solutions/distributors/">商社・卸売</a><a href="/solutions/private-label-brands/">PBブランド</a></nav></div>
    <ul class="procurement-links">{purchase.map(([href,title,copy])=><li><a href={href}><div><h3>{title}</h3><p>{copy}</p></div><span aria-hidden="true">→</span></a></li>)}</ul>
  </div></section>
  <section class="container catalog-overview guide-index" aria-labelledby="home-guides">
    <div class="catalog-heading"><h2 id="home-guides">調達ガイド</h2><a class="text-link" href="/blog/">記事一覧</a></div>
    <ul>{articles.slice(-3).reverse().map(article=>{const cover=articleVisuals[articles.indexOf(article)].cover;return <li><a href={`/blog/${article.slug}/`}><img src={cover.src} alt="" width="120" height="90" loading="lazy" /><div><p>{article.category}</p><h3>{article.title}</h3></div><span aria-hidden="true">→</span></a></li>;})}</ul>
  </section>
</Base>
