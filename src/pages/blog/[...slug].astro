---
import ArticleInquiry from '../../components/ArticleInquiry.astro';
import Base from '../../layouts/Base.astro';
import { articleVisuals } from '../../data/editorial-images';
import Sections from '../../components/Sections.astro';
import { articles, type Article } from '../../data/articles';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}));}
interface Props {article:Article}
const {article}=Astro.props;
const bodyChars=JSON.stringify(article.sections).length;
const readingMinutes=Math.max(3,Math.ceil(bodyChars/500));
const visual=articleVisuals[articles.findIndex(a=>a.slug===article.slug)];
---
<Base title={article.title} description={article.description} article image={visual.cover.src}>
  <div class="container breadcrumb"><a href="/">ホーム</a><span>/</span><a href="/blog/">解説記事</a><span>/</span><span>{article.category}</span></div>
  <article class="container article-layout"><header class="article-header"><p class="eyebrow">MATERIAL JOURNAL / {article.category}</p><h1>{article.title}</h1><p class="article-reading">約{readingMinutes}分で読めます · 製品仕様は品番別に確認</p><p class="article-byline">Tilebase 編集チーム <span>法人向け製品・調達ガイド</span></p><div class="article-answer"><p class="eyebrow">まず押さえるポイント</p><p class="article-summary">{article.summary}</p></div></header><figure class="article-hero-image"><img src={visual.cover.src} alt={visual.cover.alt} width="1200" height="800" fetchpriority="high" /><figcaption>{visual.cover.caption}</figcaption></figure><nav class="article-toc" aria-label="この記事の目次"><h2>この記事で確認すること</h2><ol>{article.sections.map((s,i)=><li><a href={`#section-${i+1}`}>{s.title}</a></li>)}{article.faq&&<li><a href="#article-faq">よくある質問</a></li>}</ol></nav><Sections sections={article.sections} visuals={visual.images}/>{article.faq&&<section class="faq-section" id="article-faq"><h2>よくある質問</h2>{article.faq.map(([q,a])=><details open><summary>{q}</summary><p>{a}</p></details>)}</section>}<ArticleInquiry intent={article.slug.includes("oem") && !article.slug.includes("import-purchasing") && !article.slug.includes("evaluate-floor") ? "oem" : article.slug.startsWith("sourcing-oem/") ? "wholesale" : "sample"}/><section class="related-section"><p class="eyebrow">RELATED INFORMATION</p><h2>製品・仕様とあわせて確認</h2><div class="related-links">{article.links.map(([href,label])=><a href={href}>{label}<span aria-hidden="true">＋</span></a>)}</div></section><a class="text-link" href="/blog/">解説記事の一覧に戻る</a></article>
</Base>


