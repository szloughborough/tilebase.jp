---
import Base from '../../layouts/Base.astro';
import { articleVisuals } from '../../data/editorial-images';
import { articles } from '../../data/articles';
---
<Base title="製品選び・施工・調達の解説記事" description="タイルシールとフロアタイルの基本、施工方式、OEM、輸入仕入れを法人向けに整理したTilebaseの解説記事。">
  <div class="container breadcrumb"><a href="/">ホーム</a><span>/</span><a href="/resources/">導入ガイド</a><span>/</span><span>解説記事</span></div>
  <section class="container page-hero"><h1>製品選び・施工・調達ガイド</h1><p class="page-intro">タイルシールとフロアタイルの選び方、施工条件、卸売・OEMの確認事項をまとめています。</p><div class="journal-topics"><a href="/products/floor-tiles/">フロア製品を見る</a><a href="/products/wall-tiles/">ウォール製品を見る</a><a href="/resources/">調達チェックリスト</a></div></section>
  <section class="container article-grid">{[...articles].reverse().map(article=><a class="article-card" href={`/blog/${article.slug}/`}><img class="article-cover" src={articleVisuals[articles.indexOf(article)].cover.src} alt={articleVisuals[articles.indexOf(article)].cover.alt} width="1200" height="800" loading="lazy" /><div class="article-label"><span>{article.category}</span></div><h2>{article.title}</h2><p>{article.summary}</p><span class="text-link">記事を読む</span></a>)}</section>
</Base>

