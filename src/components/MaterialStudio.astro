---
import { products } from '../data/site';
const options = [
  {id:'TB-F-046', title:'石目調フロア', label:'石目調', type:'FLOOR / STONE'},
  {id:'TB-W-037', title:'壁面用タイルシール', label:'ウォール', type:'WALL / TILE SHEET'},
  {id:'TB-F-039', title:'木目調フロア', label:'木目調', type:'FLOOR / WOOD'},
].map(item=>({...item, product:products.find(p=>p.id===item.id)!}));
---
<section class="material-hero" aria-labelledby="home-title">
  <div class="container material-stage">
    <div class="material-intro">
      <p class="material-kicker"><span></span> TILEBASE <span class="material-kicker-slash">/</span> JAPAN B2B</p>
      <h1 id="home-title">壁と床に、<br />次の定番を。</h1>
      <p class="material-lead">タイルシール・粘着式フロアタイルの法人調達。デザインの選定から、卸売・OEM・PBのご相談まで。</p>
      <div class="button-row material-actions">
        <a class="button button-light" href="/designs/">デザインから探す <span aria-hidden="true">↗</span></a>
        <a class="material-secondary" href="/wholesale/samples/">サンプル相談 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="material-intro-foot"><span>WALL & FLOOR MATERIALS</span><span>法人向け製品案内</span></div>
    </div>
    <div class="material-deck" data-material-deck>
      <div class="material-panels">
        {options.map((item,i)=><figure class="material-panel" id={`material-panel-${i}`} aria-labelledby={`material-tab-${i}`} hidden={i!==0}>
          <img src={item.product.gallery[1] ?? item.product.scene} alt={`${item.title}（${item.id}）の使用イメージ`} width="1200" height="1200" loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'auto'} />
          <figcaption class="material-caption">
            <div><span>{item.type} · {item.id}</span><strong>{item.title}</strong><small>使用イメージ</small></div>
            <a href={`/wholesale/samples/?model=${item.id}`} aria-label={`${item.id}のサンプルを相談`}>この品番を相談 <span aria-hidden="true">↗</span></a>
          </figcaption>
        </figure>)}
      </div>
      <div class="material-controls">
        <div class="material-control-label"><span>MATERIAL SELECTOR</span><strong>素材を切り替える</strong></div>
        <div class="material-tabs" role="tablist" aria-label="素材を切り替える" hidden>
          {options.map((item,i)=><button type="button" role="tab" id={`material-tab-${i}`} aria-controls={`material-panel-${i}`} aria-selected={i===0} tabindex={i===0?0:-1}><img src={item.product.image} alt="" width="72" height="72" /><span>{item.label}</span></button>)}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-material-deck]').forEach(deck=>{
    const list=deck.querySelector<HTMLElement>('[role="tablist"]');
    const tabs=[...deck.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels=[...deck.querySelectorAll<HTMLElement>('.material-panel')];
    if(!list||!tabs.length)return;
    list.hidden=false;
    panels.forEach(p=>p.setAttribute('role','tabpanel'));
    const select=(index:number,focus=false)=>{
      tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;panels[i].hidden=i!==index;});
      if(focus)tabs[index].focus();
    };
    tabs.forEach((tab,i)=>{
      tab.addEventListener('click',()=>select(i));
      tab.addEventListener('keydown',event=>{
        const next=event.key==='ArrowRight'?(i+1)%tabs.length:event.key==='ArrowLeft'?(i+tabs.length-1)%tabs.length:event.key==='Home'?0:event.key==='End'?tabs.length-1:null;
        if(next===null)return;
        event.preventDefault();select(next,true);
      });
    });
  });
</script>
